# Constraints for the Scaffold Rev 2 board (Artix-7 XC7A35T/XC7A100T, CSG324).
#
# PACKAGE_PIN assignments are generated from the schematic pin assignment
# (hw/rev2/fpga_pins.csv, see hw/rev2/tools/gen_fpga.py and gen_xdc.py).
# Bank voltages:
#   - banks 0/14/15/16: 3V3_FPGA (configuration, UART, LED driver, A0-A3, control)
#   - banks 34/35: VCC_IO_FPGA, adjustable 1.2 V to 3.3 V (DUT/platform I/Os)

# 25 MHz board oscillator.
create_clock -name clock -period 40.000 [get_ports clock]

# Configuration: 3.3 V bank 0, quad SPI flash, compressed bitstream.
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 33 [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]

# Asynchronous inputs and outputs: no timing relationship with the system
# clock is required (the architecture synchronizes inputs internally).
set_false_path -from [get_ports {reset_n rx teardown io[*]}]
set_false_path -to [get_ports {tx leds_* io[*] io_dir[*] pull_d* power_*}]

# I/O standards. VCC_IO_FPGA is adjustable: LVCMOS33 is declared for the
# DUT/platform banks, the actual levels follow the bank supply.
set_property IOSTANDARD LVCMOS33 [get_ports *]
set_property PULLUP TRUE [get_ports reset_n]

# --- Pin assignments (generated by hw/rev2/tools/gen_xdc.py, do not edit) ---
set_property PACKAGE_PIN C15  [get_ports {clock}]   ;# CLK_25M, bank 15
set_property PACKAGE_PIN A11  [get_ports {reset_n}]   ;# RESET_N, bank 15
set_property PACKAGE_PIN L18  [get_ports {tx}]   ;# TXD, bank 14
set_property PACKAGE_PIN M18  [get_ports {rx}]   ;# RXD, bank 14
set_property PACKAGE_PIN A14  [get_ports {leds_lat}]   ;# LED_LE, bank 15
set_property PACKAGE_PIN A13  [get_ports {leds_sclk}]   ;# LED_CLK, bank 15
set_property PACKAGE_PIN A15  [get_ports {leds_sin}]   ;# LED_SDI, bank 15
set_property PACKAGE_PIN A18  [get_ports {leds_blank}]   ;# LED_/OE, bank 15
set_property PACKAGE_PIN B14  [get_ports {power_platform}]   ;# EN_VCC_PLATFORM, bank 15
set_property PACKAGE_PIN B16  [get_ports {power_dut}]   ;# EN_VCC_DUT, bank 15
set_property PACKAGE_PIN B13  [get_ports {teardown}]   ;# TEARING, bank 15
set_property PACKAGE_PIN B7   [get_ports {pull_d0}]   ;# PULL_D0, bank 35
set_property PACKAGE_PIN C2   [get_ports {pull_d1}]   ;# PULL_D1, bank 35
set_property PACKAGE_PIN D2   [get_ports {pull_d2}]   ;# PULL_D2, bank 35
set_property PACKAGE_PIN B18  [get_ports {io[0]}]   ;# IO_A0, bank 15
set_property PACKAGE_PIN G18  [get_ports {io_dir[0]}]   ;# DIR_A0, bank 15
set_property PACKAGE_PIN D18  [get_ports {io[1]}]   ;# IO_A1, bank 15
set_property PACKAGE_PIN J18  [get_ports {io_dir[1]}]   ;# DIR_A1, bank 15
set_property PACKAGE_PIN E18  [get_ports {io[2]}]   ;# IO_A2, bank 15
set_property PACKAGE_PIN B11  [get_ports {io_dir[2]}]   ;# DIR_A2, bank 15
set_property PACKAGE_PIN F18  [get_ports {io[3]}]   ;# IO_A3, bank 15
set_property PACKAGE_PIN B12  [get_ports {io_dir[3]}]   ;# DIR_A3, bank 15
set_property PACKAGE_PIN A1   [get_ports {io[4]}]   ;# IO0_DUT, bank 35
set_property PACKAGE_PIN L1   [get_ports {io[20]}]   ;# IO0_PLAT, bank 34
set_property PACKAGE_PIN A3   [get_ports {io[5]}]   ;# IO1_DUT, bank 35
set_property PACKAGE_PIN M1   [get_ports {io[21]}]   ;# IO1_PLAT, bank 34
set_property PACKAGE_PIN A4   [get_ports {io[6]}]   ;# IO2_DUT, bank 35
set_property PACKAGE_PIN N1   [get_ports {io[22]}]   ;# IO2_PLAT, bank 34
set_property PACKAGE_PIN A5   [get_ports {io[7]}]   ;# IO3_DUT, bank 35
set_property PACKAGE_PIN R1   [get_ports {io[23]}]   ;# IO3_PLAT, bank 34
set_property PACKAGE_PIN A6   [get_ports {io[8]}]   ;# IO4_DUT, bank 35
set_property PACKAGE_PIN T1   [get_ports {io[24]}]   ;# IO4_PLAT, bank 34
set_property PACKAGE_PIN B1   [get_ports {io[9]}]   ;# IO5_DUT, bank 35
set_property PACKAGE_PIN U1   [get_ports {io[25]}]   ;# IO5_PLAT, bank 34
set_property PACKAGE_PIN C1   [get_ports {io[10]}]   ;# IO6_DUT, bank 35
set_property PACKAGE_PIN V1   [get_ports {io[26]}]   ;# IO6_PLAT, bank 34
set_property PACKAGE_PIN E1   [get_ports {io[11]}]   ;# IO7_DUT, bank 35
set_property PACKAGE_PIN V2   [get_ports {io[27]}]   ;# IO7_PLAT, bank 34
set_property PACKAGE_PIN F1   [get_ports {io[12]}]   ;# IO8_DUT, bank 35
set_property PACKAGE_PIN V4   [get_ports {io[28]}]   ;# IO8_PLAT, bank 34
set_property PACKAGE_PIN G1   [get_ports {io[13]}]   ;# IO9_DUT, bank 35
set_property PACKAGE_PIN V5   [get_ports {io[29]}]   ;# IO9_PLAT, bank 34
set_property PACKAGE_PIN H1   [get_ports {io[14]}]   ;# IO10_DUT, bank 35
set_property PACKAGE_PIN V6   [get_ports {io[30]}]   ;# IO10_PLAT, bank 34
set_property PACKAGE_PIN K1   [get_ports {io[15]}]   ;# IO11_DUT, bank 35
set_property PACKAGE_PIN V7   [get_ports {io[31]}]   ;# IO11_PLAT, bank 34
set_property PACKAGE_PIN B2   [get_ports {io[16]}]   ;# IO12_DUT, bank 35
set_property PACKAGE_PIN V9   [get_ports {io[32]}]   ;# IO12_PLAT, bank 34
set_property PACKAGE_PIN B3   [get_ports {io[17]}]   ;# IO13_DUT, bank 35
set_property PACKAGE_PIN M2   [get_ports {io[33]}]   ;# IO13_PLAT, bank 34
set_property PACKAGE_PIN B4   [get_ports {io[18]}]   ;# IO14_DUT, bank 35
set_property PACKAGE_PIN N2   [get_ports {io[34]}]   ;# IO14_PLAT, bank 34
set_property PACKAGE_PIN B6   [get_ports {io[19]}]   ;# IO15_DUT, bank 35
set_property PACKAGE_PIN P2   [get_ports {io[35]}]   ;# IO15_PLAT, bank 34
# Board nets wired to the FPGA but not used by the gateware: CLK_EXT=G16, FLASH_CS=L13, FLASH_IO0=K17, FLASH_IO1=K18, FLASH_IO2=L14, FLASH_IO3=M14, LED_SDO=A16, PD_SCL=P18, PD_SDA=R18, PUDC_B=L15, SPARE_0=T18, SPARE_1=U18, SPARE_2=V10, SPARE_3=V11, SPARE_4=V12, SPARE_5=V14, SPARE_6=V15
# --- End of generated pin assignments ---
